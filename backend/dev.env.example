# Local development only. Compose binds the API to loopback.
POSTGRES_PASSWORD=replace-with-a-long-local-database-password
ALLOW_DEMO_AUTH=true
ADMIN_EMAIL=admin@local.test
ADMIN_PASSWORD=
# For authenticated use, set ALLOW_DEMO_AUTH=false and a strong ADMIN_PASSWORD.
# Use TLS and SESSION_COOKIE_SECURE=true before exposing a local deployment.
